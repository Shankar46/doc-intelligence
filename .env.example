# --- App ---
APP_NAME=Document Intelligence Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# SQLite is fine for this assignment. For Postgres use e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/documents.db

# --- File handling ---
MAX_PAGES=20
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=backend/data/uploads

# --- OCR ---
# tesseract path only needed on some OS/deploy targets
TESSERACT_CMD=

# --- LLM provider (pick one, leave others blank) ---
LLM_PROVIDER=

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=
HUGGINGFACE_BASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=


# Optional remote LLM fallback (disabled by default for speed/reliability)
USE_LLM_FALLBACK=false
