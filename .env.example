# --- App ---
APP_NAME=Document Intelligence Platform
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---
# SQLite is fine for this assignment. For Postgres use e.g.
# postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./data/app.db

# --- File handling ---
MAX_PAGES=3
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./data/uploads

# --- OCR ---
# tesseract path only needed on some OS/deploy targets
TESSERACT_CMD=

# --- LLM provider (pick one, leave others blank) ---
LLM_PROVIDER=huggingface

HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=deepseek-ai/DeepSeek-R1
HUGGINGFACE_BASE_URL=https://router.huggingface.co/hf-inference/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# Optional LLM completion for fields missed by deterministic OCR.
# Safe without a key: the application automatically uses deterministic OCR only.
USE_LLM_FALLBACK=true
